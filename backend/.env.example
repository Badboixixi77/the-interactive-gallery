PORT=3001
DATABASE_URL=postgresql://user@localhost:5432/interactive_gallery

# On Render, DATABASE_URL and FRONTEND_URL are auto-set via render.yaml
# For local dev, point DATABASE_URL to your local PostgreSQL instance
PORT=3001
DATABASE_URL=postgresql://user@localhost:5432/interactive_gallery

# JWT secret for user authentication — use a long random string in production
JWT_SECRET=your-long-random-secret-here
