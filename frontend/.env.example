# Local development
REACT_APP_BACKEND_URL=http://localhost:3001

# Unsplash API — get your key at https://unsplash.com/developers
REACT_APP_UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# On Render, REACT_APP_BACKEND_URL is auto-set via render.yaml
# On Vercel, set it manually in the Vercel dashboard
REACT_APP_BACKEND_URL=http://localhost:3001
REACT_APP_UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
